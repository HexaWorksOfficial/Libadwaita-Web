---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="en" class="dark" id="html-root">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg" href="/Adwaita.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Libadwaita Web</title>
    <style>
      .sidebar-item-active {
        background-color: var(--accent-color) !important;
        color: #ffffff !important;
        font-weight: 600 !important;
      }
      .gnome-switch {
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      .gnome-switch-knob {
        transition: transform 0.2s cubic-bezier(0.1, 0.9, 0.2, 1);
      }
      @keyframes gnome-spin {
        to { transform: rotate(360deg); }
      }
      .gnome-spinner {
        animation: gnome-spin 0.8s linear infinite;
      }
      /* Global animation control */
      .no-animations *, .no-animations {
        transition: none !important;
        animation: none !important;
      }
    </style>
  </head>
  <body class="h-screen overflow-hidden flex flex-col antialiased selection:bg-[#3584e4] selection:text-white" id="app-body">
    
    <!-- GNOME HeaderBar Style -->
    <header class="h-14 border-b px-4 flex items-center justify-between shrink-0 select-none z-20 transition-colors duration-200" style="background-color: var(--headerbar-bg-color); border-color: var(--border-color);">
      <div class="flex items-center gap-3">
        <img src="/Adwaita.svg" alt="Adwaita" class="h-6 w-auto object-contain" />
        <span class="font-bold text-sm" style="color: var(--window-fg-color);">Libadwaita Web</span>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="https://gitlab.gnome.org/GNOME/libadwaita/" 
          target="_blank"
          rel="noopener noreferrer"
          class="text-white text-xs font-bold px-3.5 py-1.5 rounded-xl transition-all shadow-sm flex items-center gap-2 active:scale-95"
          style="background-color: var(--accent-color);"
          title="Official Libadwaita Git Repository"
        >
          <span>Libadwaita</span>
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M23.955 13.873l-1.3-3.972-2.022-6.222c-.13-.396-.677-.396-.807 0L18.8 9.68H5.2L3.174 3.679c-.13-.396-.677-.396-.807 0L.345 13.873c-.158.486.014 1.025.424 1.321L12 23.3l11.231-8.106c.41-.296.582-.835.424-1.321z"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- APP WINDOW SPLIT VIEW -->
    <div class="flex-1 flex overflow-hidden">
      
      <!-- SIDEBAR -->
      <aside class="w-72 border-r flex flex-col p-3 shrink-0 select-none transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
        <div class="px-3 py-2 text-xs font-bold opacity-40 uppercase tracking-wider flex items-center justify-between">
          <span>Sidebar</span>
        </div>
        
        <nav class="flex flex-col gap-1 mt-1">
          <button data-view="overview" class="tab-btn sidebar-item-active w-full flex items-center gap-3 px-3.5 py-2.5 text-xs font-medium rounded-xl transition-all text-left opacity-80 hover:opacity-100 hover:bg-[var(--card-hover-bg-color)]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
            <span>Overview</span>
          </button>
          
          <button data-view="controls" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 text-xs font-medium rounded-xl transition-all text-left opacity-80 hover:opacity-100 hover:bg-[var(--card-hover-bg-color)]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c-.5.38 1.03.7 1.62.94l.36 2.54c-.05.24.24.41.48.41h3.84c-.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
            <span>Controls & Switches</span>
          </button>

          <button data-view="inputs" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 text-xs font-medium rounded-xl transition-all text-left opacity-80 hover:opacity-100 hover:bg-[var(--card-hover-bg-color)]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <span>Inputs & Search</span>
          </button>

          <button data-view="advanced" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 text-xs font-medium rounded-xl transition-all text-left opacity-80 hover:opacity-100 hover:bg-[var(--card-hover-bg-color)]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
            <span>Advanced Widgets</span>
          </button>

          <button data-view="dialogs" class="tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 text-xs font-medium rounded-xl transition-all text-left opacity-80 hover:opacity-100 hover:bg-[var(--card-hover-bg-color)]">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
            <span>Dialogs & Alerts</span>
          </button>
        </nav>
      </aside>

      <!-- CONTENT STACK -->
      <main class="flex-1 overflow-y-auto p-8 lg:p-12 transition-colors duration-200">
        <div class="max-w-3xl mx-auto space-y-6">
          
          <!-- VIEW 1: OVERVIEW -->
          <div id="view-overview" class="view-content space-y-6">
            <div class="border rounded-3xl p-8 shadow-2xl relative overflow-hidden transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold border mb-6 shadow-sm" style="background-color: var(--window-bg-color); color: var(--accent-color); border-color: var(--border-color);">
                <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--accent-color);"></span>
                GNOME HIG Architecture
              </div>
              <h1 class="text-3xl font-black tracking-tight mb-4">
                Libadwaita Web
              </h1>
              <p class="opacity-75 text-base leading-relaxed mb-4">
                Libadwaita Web is an CSS + Astro Theme for WebSites, based on Libadwaita and Adwaita.
              </p>
              <div class="border p-4 rounded-2xl text-xs opacity-80 space-y-1 transition-colors duration-200" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
                <p class="font-bold uppercase tracking-wider text-[10px] opacity-60">Tip:</p>
                <p>Use the sidebar navigation on the left to explore different interactive GNOME HIG components and test their behaviors dynamically.</p>
              </div>
            </div>
          </div>

          <!-- VIEW 2: CONTROLS -->
          <div id="view-controls" class="view-content space-y-6 hidden">
            <h2 class="text-lg font-bold px-2">Switches & Preferences</h2>
            <div class="border rounded-2xl divide-y overflow-hidden shadow-xl transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
              
              <!-- Dark Mode Switch -->
              <div class="p-5 flex items-center justify-between transition-all hover:bg-[var(--card-hover-bg-color)]">
                <div>
                  <h3 class="font-bold text-base">Dark Appearance</h3>
                  <p class="text-sm opacity-60">Toggle light and dark color scheme across the layout.</p>
                </div>
                <button id="switch-dark" type="button" class="gnome-switch w-12 h-7 rounded-full p-1 relative shadow-inner focus:outline-none" style="background-color: var(--accent-color);">
                  <div class="gnome-switch-knob w-5 h-5 bg-white rounded-full shadow-md transform translate-x-5"></div>
                </button>
              </div>

              <!-- Animations Switch -->
              <div class="p-5 flex items-center justify-between transition-all hover:bg-[var(--card-hover-bg-color)]">
                <div>
                  <h3 class="font-bold text-base">Animations</h3>
                  <p class="text-sm opacity-60">Enable or disable all page-wide transitions and animations.</p>
                </div>
                <button id="switch-anim" type="button" class="gnome-switch w-12 h-7 rounded-full p-1 relative shadow-inner focus:outline-none" style="background-color: var(--accent-color);">
                  <div class="gnome-switch-knob w-5 h-5 bg-white rounded-full shadow-md transform translate-x-5"></div>
                </button>
              </div>

            </div>
            <div class="border p-4 rounded-2xl text-xs opacity-80 space-y-1 transition-colors duration-200 mx-2" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
              <p class="font-bold uppercase tracking-wider text-[10px] opacity-60">Tip:</p>
              <p>Toggling 'Dark Appearance' switches CSS variables instantly. Turning off 'Animations' injects a global override class to halt transitions.</p>
            </div>
          </div>

          <!-- VIEW 3: INPUTS -->
          <div id="view-inputs" class="view-content space-y-6 hidden">
            <h2 class="text-lg font-bold px-2">Inputs & Search Entries</h2>
            <div class="border rounded-2xl p-6 space-y-6 shadow-xl transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
              <div>
                <label class="block text-xs font-semibold opacity-70 mb-2 uppercase tracking-wide">Search Component</label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none opacity-40">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                  </span>
                  <input 
                    type="text" 
                    placeholder="Search applications or settings..." 
                    class="w-full text-sm rounded-xl pl-10 pr-4 py-2.5 border focus:outline-none transition-all shadow-inner" 
                    style="background-color: var(--window-bg-color); border-color: var(--border-color);" 
                    onfocus="this.style.borderColor='var(--accent-color)'" 
                    onblur="this.style.borderColor='var(--border-color)'"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold opacity-70 mb-2 uppercase tracking-wide">Progress Indicator</label>
                <div class="rounded-full h-2.5 overflow-hidden border p-0.5" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
                  <div class="h-full rounded-full w-3/4 animate-pulse" style="background-color: var(--accent-color);"></div>
                </div>
              </div>
            </div>
            <div class="border p-4 rounded-2xl text-xs opacity-80 space-y-1 transition-colors duration-200 mx-2" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
              <p class="font-bold uppercase tracking-wider text-[10px] opacity-60">Tip:</p>
              <p>Search entries feature leading icons and inset padding following GNOME Human Interface Guidelines for input controls.</p>
            </div>
          </div>

          <!-- VIEW 4: ADVANCED -->
          <div id="view-advanced" class="view-content space-y-6 hidden">
            <h2 class="text-lg font-bold px-2">Advanced HIG Widgets</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              <div class="border rounded-2xl p-6 shadow-xl flex flex-col justify-between space-y-6 transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
                <div>
                  <h3 class="font-bold text-base mb-1">Activity Spinner</h3>
                  <p class="text-sm opacity-60">Standard GNOME loading indicator.</p>
                </div>
                <div class="flex items-center justify-center py-6 rounded-xl border" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
                  <svg class="gnome-spinner w-8 h-8" style="color: var(--accent-color);" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </div>
              </div>

              <div class="border rounded-2xl p-6 shadow-xl flex flex-col justify-between space-y-6 relative transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
                <div>
                  <h3 class="font-bold text-base mb-1">Menu Popover</h3>
                  <p class="text-sm opacity-60">Contextual action menu anchored to buttons.</p>
                </div>
                
                <div class="relative">
                  <button id="popover-btn" class="w-full font-semibold text-xs px-4 py-3 rounded-xl border transition-all flex items-center justify-between active:scale-95 shadow-sm hover:bg-[var(--card-hover-bg-color)]" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
                    <span>Primary Menu Options</span>
                    <svg class="w-4 h-4 fill-current opacity-70" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
                  </button>

                  <div id="popover-menu" class="absolute left-0 right-0 mt-2 border rounded-2xl p-2 shadow-2xl hidden z-20 space-y-1" style="background-color: var(--popover-bg-color); border-color: var(--border-color);">
                    <button class="w-full text-left px-3 py-2 text-xs font-medium opacity-80 hover:opacity-100 hover:bg-[#3584e4] hover:text-white rounded-xl transition-all">Preferences</button>
                    <button class="w-full text-left px-3 py-2 text-xs font-medium opacity-80 hover:opacity-100 hover:bg-[#3584e4] hover:text-white rounded-xl transition-all">Keyboard Shortcuts</button>
                    <div class="border-t my-1" style="border-color: var(--border-color);"></div>
                    <button class="w-full text-left px-3 py-2 text-xs font-medium text-red-500 hover:bg-red-500 hover:text-white rounded-xl transition-all">Quit Application</button>
                  </div>
                </div>

              </div>

            </div>
            <div class="border p-4 rounded-2xl text-xs opacity-80 space-y-1 transition-colors duration-200 mx-2" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
              <p class="font-bold uppercase tracking-wider text-[10px] opacity-60">Tip:</p>
              <p>Spinners indicate background processing tasks, while menu popovers present contextual actions tied directly to interactive controls.</p>
            </div>
          </div>

          <!-- VIEW 5: DIALOGS -->
          <div id="view-dialogs" class="view-content space-y-6 hidden">
            <div class="border rounded-3xl p-8 shadow-2xl space-y-6 transition-colors duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);">
              <h2 class="text-2xl font-bold">Dialogs & Notifications</h2>
              <p class="opacity-75 leading-relaxed">Test GNOME style modal dialogs for confirmations and alerts.</p>
              <button id="open-dialog-btn" class="text-white font-semibold text-sm px-6 py-3 rounded-2xl transition-all shadow-md active:scale-95" style="background-color: var(--accent-color);">
                Open Message Dialog
              </button>
            </div>
            <div class="border p-4 rounded-2xl text-xs opacity-80 space-y-1 transition-colors duration-200 mx-2" style="background-color: var(--window-bg-color); border-color: var(--border-color);">
              <p class="font-bold uppercase tracking-wider text-[10px] opacity-60">Tip:</p>
              <p>Modal dialogs create focus overlays, demanding user confirmation or cancellation before returning to the main window workflow.</p>
            </div>
          </div>

        </div>
      </main>
    </div>

    <!-- MODAL DIALOG -->
    <div id="modal-dialog" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200">
      <div class="border rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-transform duration-200" style="background-color: var(--card-bg-color); border-color: var(--border-color);" id="modal-box">
        <h3 class="text-xl font-bold mb-3">Confirm Action</h3>
        <p class="opacity-75 text-sm mb-6 leading-relaxed">You really want to do that?</p>
        <div class="flex justify-end gap-3">
          <button id="close-dialog-btn" class="font-semibold text-xs px-5 py-2.5 rounded-xl border transition-all active:scale-95 hover:bg-[var(--card-hover-bg-color)]" style="background-color: var(--window-bg-color); border-color: var(--border-color);">Cancel</button>
          <button id="confirm-dialog-btn" class="text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition-all shadow-md active:scale-95" style="background-color: var(--accent-color);">Apply</button>
        </div>
      </div>
    </div>

    <!-- SCRIPTS -->
    <script>
      const tabButtons = document.querySelectorAll('.tab-btn');
      const viewContents = document.querySelectorAll('.view-content');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetView = btn.getAttribute('data-view');

          tabButtons.forEach(b => b.classList.remove('sidebar-item-active'));
          btn.classList.add('sidebar-item-active');

          viewContents.forEach(view => {
            if (view.id === `view-${targetView}`) {
              view.classList.remove('hidden');
            } else {
              view.classList.add('hidden');
            }
          });
        });
      });

      // Dark Mode Switch Logic
      const htmlRoot = document.getElementById('html-root');
      const switchDark = document.getElementById('switch-dark');

      switchDark?.addEventListener('click', () => {
        const knob = switchDark.querySelector('.gnome-switch-knob');
        const isDark = htmlRoot?.classList.contains('dark');

        if (isDark) {
          htmlRoot?.classList.remove('dark');
          switchDark.style.backgroundColor = '#454545';
          knob?.classList.remove('translate-x-5');
          knob?.classList.add('translate-x-0');
        } else {
          htmlRoot?.classList.add('dark');
          switchDark.style.backgroundColor = 'var(--accent-color)';
          knob?.classList.remove('translate-x-0');
          knob?.classList.add('translate-x-5');
        }
      });

      // Animations Switch Logic (Enables/Disables all animations)
      const appBody = document.getElementById('app-body');
      const switchAnim = document.getElementById('switch-anim');

      switchAnim?.addEventListener('click', () => {
        const knob = switchAnim.querySelector('.gnome-switch-knob');
        const isAnimEnabled = !appBody?.classList.contains('no-animations');

        if (isAnimEnabled) {
          appBody?.classList.add('no-animations');
          switchAnim.style.backgroundColor = '#454545';
          knob?.classList.remove('translate-x-5');
          knob?.classList.add('translate-x-0');
        } else {
          appBody?.classList.remove('no-animations');
          switchAnim.style.backgroundColor = 'var(--accent-color)';
          knob?.classList.remove('translate-x-0');
          knob?.classList.add('translate-x-5');
        }
      });

      // Popover Menu Toggle
      const popoverBtn = document.getElementById('popover-btn');
      const popoverMenu = document.getElementById('popover-menu');

      popoverBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        popoverMenu?.classList.toggle('hidden');
      });

      window.addEventListener('click', () => {
        popoverMenu?.classList.add('hidden');
      });

      // Modal Dialog
      const modal = document.getElementById('modal-dialog');
      const modalBox = document.getElementById('modal-box');
      const openBtn = document.getElementById('open-dialog-btn');
      const closeBtn = document.getElementById('close-dialog-btn');
      const confirmBtn = document.getElementById('confirm-dialog-btn');

      const toggleModal = (show: boolean) => {
        if (show) {
          modal?.classList.remove('hidden');
          setTimeout(() => {
            modal?.classList.remove('opacity-0');
            modalBox?.classList.remove('scale-95');
            modalBox?.classList.add('scale-100');
          }, 10);
        } else {
          modal?.classList.add('opacity-0');
          modalBox?.classList.remove('scale-100');
          modalBox?.classList.add('scale-95');
          setTimeout(() => {
            modal?.classList.add('hidden');
          }, 200);
        }
      };

      openBtn?.addEventListener('click', () => toggleModal(true));
      closeBtn?.addEventListener('click', () => toggleModal(false));
      confirmBtn?.addEventListener('click', () => toggleModal(false));
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) toggleModal(false);
      });
    </script>
  </body>
</html>
